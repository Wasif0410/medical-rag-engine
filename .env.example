# Generate a key with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
MEDICAL_RAG_API_KEY=
# Copying this file does not load it for native CLI commands. Export variables in
# your shell, or use `uv run --env-file .env ...`. Docker Compose loads it automatically.
MEDICAL_RAG_DATABASE=data/corpus.sqlite3
MEDICAL_RAG_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEDICAL_RAG_MODEL_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
MEDICAL_RAG_LOCAL_MODEL_ONLY=false
MEDICAL_RAG_ALLOW_UNAUTHENTICATED=false
MEDICAL_RAG_MAX_PDF_BYTES=524288000
MEDICAL_RAG_MAX_PDF_PAGES=10000
